#!/usr/bin/env bash
set -euo pipefail

VERSION="${1:-}"

if [[ -z "$VERSION" ]]; then
    echo "Usage: $0 <version>  (e.g. v0.2.0)"
    exit 1
fi

if ! [[ "$VERSION" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Error: version must be vX.Y.Z (e.g. v0.2.0)"
    exit 1
fi

CURRENT=$(git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null || echo "none")
COUNT=$(git rev-list --count HEAD)

echo "Current tag:  $CURRENT"
echo "New tag:      $VERSION"
echo "Total commits: $COUNT (4th number resets to 0 after tagging)"
echo ""
read -r -p "Create tag $VERSION? [y/N] " confirm
if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo "Aborted."
    exit 0
fi

git tag "$VERSION"
echo "Done. Push with: git push origin $VERSION"
